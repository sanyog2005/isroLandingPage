---
<section id="schedules" class="relative py-20 px-12 max-w-full mx-auto overflow-hidden">
  
  <div class="absolute top-1/2 left-0 pointer-events-none -z-10" 
       style="width: 250px; height: 250px; border-radius: 250px; background: rgba(255, 135, 49, 0.78); filter: blur(90.7px); transform: translate(-30%, -50%);">
  </div>

  <div class="absolute top-1/2 right-0 pointer-events-none -z-10" 
       style="width: 250px; height: 250px; border-radius: 250px; opacity: 0.57; background: linear-gradient(90deg, #163FF3 0%, #5575FF 100%); filter: blur(70.7px); transform: translate(15%, -50%) rotate(-90.526deg);">
  </div>

  <div class="flex justify-center w-full mb-12 lg:mb-20">
    <h2 style="
      width: 351px;
      height: auto;
      text-align: center;
      font-family: 'Pilat Extended', sans-serif !important;
      font-size: 28px;
      font-style: normal;
      font-weight: 850;
      line-height: 133%;
      background: linear-gradient(91deg, #FFF 26.02%, #FF964A 68.96%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    ">
      Timeline
    </h2>
  </div>

  <div class="block lg:hidden w-full px-0 sm:px-4 pb-10 relative z-10">
    <div style="display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; row-gap: 4rem; max-width: 400px; margin: 0 auto; position: relative;">
      
      {timelineEvents.map((event, index) => {
        
        // --- 1. Explicit Grid Positioning for Mobile Flow ---
        let col = 1, row = 1;
        if (index === 0) { col = 1; row = 1; }
        else if (index === 1) { col = 2; row = 1; }
        else if (index === 2) { col = 2; row = 2; }
        else if (index === 3) { col = 1; row = 2; }
        else if (index === 4) { col = 1; row = 3; }
        else if (index === 5) { col = 2; row = 3; }
        else if (index === 6) { col = 2; row = 4; }
        else if (index === 7) { col = 1; row = 4; }

        // --- 2. Box & Line Theme Variables ---
        const isOrange = event.type === "orange";
        const boxBorder = isOrange ? "0.797px solid #FF8A37" : "0.768px solid #82AFFF";
        const boxBg = isOrange ? "rgba(255, 138, 55, 0.43)" : "rgba(130, 175, 255, 0.43)";
        
        const orangeLine = "border: 1.034px solid #FF8A37; background: rgba(255, 138, 55, 0.43);";
        const blueLine = "border: 1.034px solid #82AFFF; background: rgba(130, 175, 255, 0.43);";

        // --- 3. Pixel-Perfect Line Routing ---
        let mobileLine = null;

        if (index === 0) {
          // Starts: Straight Right
          mobileLine = <div class="absolute z-0" style={`top: 17px; left: 41px; width: calc(90% + 1rem); height: 6px; ${orangeLine} border-right: none;`}></div>;
        } else if (index === 1) {
          // Ends: Wrap Right-Down-Left
          mobileLine = (
            <>
              <div class="absolute z-0" style={`top: 17px; left: 44px; width: calc(87% - 21px + 1rem); height: 6px; ${blueLine} border-right: none;`}></div>
              <div class="absolute z-0" style={`top: 17px; left: calc(100% + 1.5rem - 6.5px); width: 6px; height: calc(100% + 3rem + 0px); ${blueLine} border-top: none; border-bottom: none;`}></div>
              {/* <div class="absolute z-0" style={`top: calc(100% + 4rem + 19px); left: 21px; width: calc(100% - 21px + 1.5rem); height: 6px; ${blueLine} border-left: none;`}></div> */}
            </>
          );
        } else if (index === 2) {
          // Session 1: Straight Left
          mobileLine = <div class="absolute z-0" style={`top: 17px; left: 45px; width: calc(73% + 1rem); height: 6px; ${orangeLine} border-left: none;`}></div>;
        } else if (index === 3) {
          // Session 2: Wrap Left-Down-Right
          mobileLine = (
            <>
              <div class="absolute z-0" style={`top: 17px; left: 41px; width: calc(100% - 21px + 1.5rem); height: 6px; ${blueLine} border-left: none;`}></div>
              <div class="absolute z-0" style={`top: 17px; left: -20px; width: calc(60% - 65px); height: 6px; ${blueLine} border-left: none;`}></div>

              <div class="absolute z-0" style={`top: 17px; right: calc(100% + 1.5rem - 8px); width: 6px; height: calc(100% + 3rem + 4px); ${blueLine} border-top: none; border-bottom: none;`}></div>
              <div class="absolute z-0" style={`top: calc(100% + 4rem + 17px); left: -20px; width: calc(10% - 21px + 1.5rem); height: 6px; ${orangeLine} border-right: none;`}></div>
            </>
          );
        } else if (index === 4) {
          // Mentor Start: Straight Right
          mobileLine = <div class="absolute z-0" style={`top: 17px; left: 40px; width: calc(95% + 1rem); height: 6px; ${blueLine} border-right: none;`}></div>;
        } else if (index === 5) {
          // Mentor End: Wrap Right-Down-Left
          mobileLine = (
            <>
              <div class="absolute z-0" style={`top: 17px; left: 35px; width: calc(100% - 21px + 0.5rem); height: 6px; ${blueLine} border-right: none;`}></div>
              <div class="absolute z-0" style={`top: 17px; left: calc(100% + 1.5rem - 8px); width: 6px; height: calc(100% + 3rem + 8px); ${blueLine} border-top: none; border-bottom: none;`}></div>
              <div class="absolute z-0" style={`top: calc(100% + 4rem + 17px); left: 45px; width: calc(100% - 29px + 0.5rem); height: 6px; ${orangeLine} border-left: none;`}></div>
            </>
          );
        } else if (index === 6) {
          // Announcement: Straight Left
mobileLine = <div class="absolute z-0" style={`top: 17px; right: calc(100% - 10px); width: calc(100% + 0.8rem); height: 6px; ${orangeLine} border-left: none;`}></div>;
        }

        return (
          <div style={`grid-column: ${col}; grid-row: ${row}; position: relative; width: 100%; max-width: 170px; justify-self: center; display: flex; flex-direction: column; height: 100%;`}>
            
            {/* The Line */}
            {mobileLine}

            {/* Icon Wrapper (Set to bg-transparent) */}
            <div class="relative z-10 bg-transparent w-[42px] h-[42px] flex items-center justify-center" set:html={event.icon} />

            {/* Title Text */}
            <h3 class="relative z-10" style="margin-top: 12px; color: #FFF; font-family: 'Abel', sans-serif !important; font-size: 13px; font-weight: 400; line-height: 140%;" set:html={event.title} />

            {/* Date Box (Uses mt-auto to align bottoms perfectly regardless of text height) */}
            <div class="relative z-10 mt-auto pt-4" style="width: 100%;">
              <div style={`width: 100%; height: 32px; border: ${boxBorder}; background: ${boxBg}; display: flex; align-items: center; justify-content: center;`}>
                <span style="color: #FFF; text-align: center; font-family: 'Abel', sans-serif !important; font-size: 11px; font-weight: 400; line-height: 133%;">{event.date}</span>
              </div>
            </div>

          </div>
        );
      })}
      
    </div>
  </div>


  <div class="hidden lg:block w-full overflow-x-auto pb-10">
    <div style="
      display: grid;
      grid-template-columns: repeat(5, 188.047px);
      column-gap: 36.07px;
      row-gap: 30px;
      width: max-content;
      margin: 0 auto;
    ">
      
      {timelineEvents.map((event) => {
        
        const isOrange = event.type === "orange";
        let borderColor = isOrange ? "#FF8A37" : "#82AFFF";
        let bgColor = isOrange ? "rgba(255, 138, 55, 0.43)" : "rgba(130, 175, 255, 0.43)";
        const boxBorder = isOrange ? "0.797px solid #FF8A37" : "0.768px solid #82AFFF";

        // OVERRIDES FOR PERFECT VISUAL ALTERNATION ON THE BOTTOM ROW
        if (event.gridCol === 5 && event.gridRow === 2) {
          // Force the line leaving the Col 5 Blue icon to be Orange
          borderColor = "#FF8A37";
          bgColor = "rgba(255, 138, 55, 0.43)";
        }
        if (event.gridCol === 4 && event.gridRow === 2) {
          // Force the line leaving the Col 4 Orange icon to be Blue
          borderColor = "#82AFFF";
          bgColor = "rgba(130, 175, 255, 0.43)";
        }

        return (
          <div style={`grid-column: ${event.gridCol}; grid-row: ${event.gridRow}; position: relative; width: 188.047px; height: 210px;`}>
            
            <div class="relative z-10" style="width: 42.981px; height: 42.982px;" set:html={event.icon} />

            <h3 class="relative z-10" style="
              margin-top: 16px;
              width: 162.718px;
              color: #FFF;
              font-family: 'Abel', sans-serif !important;
              font-size: 20.896px;
              font-style: normal;
              font-weight: 400;
              line-height: 133%;
            " set:html={event.title} />

            <div class="relative z-10" style={`
              position: absolute;
              bottom: 0;
              left: 0;
              width: 188.047px;
              height: 46.82px;
              border: ${boxBorder};
              background: ${isOrange ? "rgba(255, 138, 55, 0.43)" : "rgba(130, 175, 255, 0.43)"};
              display: flex;
              align-items: center;
              justify-content: center;
            `}>
              <span style="
                width: 116.666px;
                color: #FFF;
                text-align: center;
                font-family: 'Abel', sans-serif !important;
                font-size: 19.956px;
                font-style: normal;
                font-weight: 400;
                line-height: 133%;
              ">{event.date}</span>
            </div>

            {event.line === "right" && (
              <div class="absolute z-0" style={`
                top: 17.653px; 
                left: 48.981px; 
                width: 161.139px; 
                height: 7.675px; 
                border: 0.768px solid ${borderColor}; 
                background: ${bgColor};
              `}></div>
            )}

            {event.line === "left" && (
              <div class="absolute z-0" style={`
                top: 17.653px; 
                left: -172.139px; 
                width: 161.139px; 
                height: 7.675px; 
                border: 0.768px solid ${borderColor}; 
                background: ${bgColor};
              `}></div>
            )}

            {event.line === "wrap" && (
              <div class="absolute z-0" style="top: 17.653px; left: 42.981px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="190" height="230" viewBox="0 0 190 249" fill="none">
                  <path d="M189.5 0.5H0.5V8.5H181.5V248H189.5V0.5Z" fill="#744225" stroke="#FF8A37"/>
                </svg>
                <div style="
                  position: absolute;
                  top: 240.325px; 
                  left: 0px; 
                  width: 181.5px; 
                  height: 7.675px; 
                  border: 0.768px solid #82AFFF; 
                  background: rgba(130, 175, 255, 0.43);
                "></div>
              </div>
            )}
            
          </div>
        );
      })}
      
    </div>
  </div>
</section>