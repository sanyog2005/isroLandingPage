---
const faqs = [
  {
    q: 'Who can participate in the Bharatiya Antariksh Hackathon 2025?',
    a: 'Undergraduate, Graduate/Postgraduate, and PhD students currently enrolled in an Indian institution.'
  },
  {
    q: 'What should be the ideal team size?',
    a: 'Each team must consist of 3 to 4 members, possibly from different colleges/universities.'
  },
  {
    q: 'What is the cost of participating in Bharatiya Antariksh Hackathon 2026?',
    a: 'Participation is entirely free. No registration or submission fee is required.'
  },
  {
    q: 'Do I need prior space research experience to participate?',
    a: 'No prior space research experience is required! Anyone with a passion for innovation and problem-solving can participate.'
  },
  {
    q: 'Will ISRO mentors be available throughout the hackathon?',
    a: 'Yes, selected teams will receive valuable insights and direct technical mentorship from ISRO scientists and domain experts.'
  },
  {
    q: 'Do we have to create a prototype in the current idea submission phase?',
    a: 'No, the initial phase only requires a detailed concept/idea proposal submission following the provided templates.'
  }
];
---

<section id="faqs" class="relative py-10 lg:py-24 px-4 lg:px-6 max-w-full mx-auto overflow-hidden">
  
  <!-- Background Gradients (Untouched) -->
  <div class="absolute top-1/2 left-0 pointer-events-none -z-10" 
       style="
         width: 208px; 
         height: 200px; 
         border-radius: 200px; 
         background: rgba(255, 135, 49, 0.78); 
         filter: blur(90.7px); 
         transform: translate(-30%, -50%);
       ">
  </div>

  <div class="absolute top-1/2 right-0 pointer-events-none -z-10" 
       style="
         width: 208px; 
         height: 150px; 
         border-radius: 200px;  
         opacity: 0.87; 
         background: linear-gradient(90deg, #163FF3 0%, #5575FF 100%); 
         filter: blur(70.7px); 
         transform: translate(15%, -50%) rotate(-90.526deg);
       ">
  </div>
  
  <!-- ======================================================== -->
  <!-- 1. MOBILE VIEW (Visible only on small screens)           -->
  <!-- ======================================================== -->
  
  <!-- Mobile Heading -->
  <div class="flex lg:hidden justify-center w-full mb-8">
    <h2 style="
      text-align: center;
      font-family: 'Abel', sans-serif !important;
      font-size: 24px;
      font-style: normal;
      font-weight: 750;
      line-height: 133%;
      background: linear-gradient(90deg, #FFF 0%, #6FA4FF 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    ">
      Frequently Asked Question
    </h2>
  </div>

  <!-- Mobile FAQ List -->
  <div class="block lg:hidden max-w-full mx-auto content-center border-t border-[#2a2d36]">
    {faqs.map((faq, i) => {
      const isOrange = i % 2 === 0;
      const themeColor = isOrange ? '#FF8F3F' : '#82AFFF';
      
      return (
        <div class="faq-item border-b border-[#2a2d36] group cursor-pointer">
          <!-- Accordion Header Row -->
          <div class="flex items-start justify-between py-5 gap-3 select-none w-full">
            
            <div class="flex items-start gap-4 flex-1">
              <!-- Number Box -->
              <span style={`
                font-family: 'Orbitron', sans-serif !important;
                font-size: 14px;
                font-weight: 450;
                color: ${themeColor};
                line-height: 1.4;
                margin-top: 1px;
              `}>
                {String(i + 1).padStart(2, '0')}
              </span>
              
              <!-- Question Text -->
              <h3 class="pr-2" style={`
                color: ${themeColor};
                font-family: 'Abel', sans-serif !important;
                font-size: 14px;
                font-style: normal;
                font-weight: 400;
                line-height: 140%;
              `}>
                {faq.q}
              </h3>
            </div>

            <!-- Custom Chevron Arrow Icon -->
            <div class="chevron-icon transition-transform duration-300 transform flex-shrink-0 mt-1">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={themeColor} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            
          </div>

          <!-- Accordion Expandable Content Panel -->
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="pb-5 pl-[38px] pr-4">
              <p style="
                color: #c4c7cf;
                font-family: 'Abel', sans-serif !important;
                font-size: 13px;
                font-style: normal;
                font-weight: 400;
                line-height: 150%;
              ">
                {faq.a}
              </p>
            </div>
          </div>
        </div>
      );
    })}
  </div>


  <!-- ======================================================== -->
  <!-- 2. DESKTOP VIEW (Your exact, untouched original code)    -->
  <!-- ======================================================== -->
  
  <!-- Desktop Heading -->
  <div class="hidden lg:flex justify-center w-full mb-16">
    <h2 style="
      text-align: center;
      font-family: 'Abel', sans-serif !important;
      font-size: 32px;
      font-style: normal;
      font-weight: 750;
      line-height: 133%;
      background: linear-gradient(90deg, #FFF 0%, #6FA4FF 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    ">
      Frequently Asked Question
    </h2>
  </div>

  <!-- Desktop FAQ List -->
  <div class="hidden lg:block max-w-[1200px] mx-auto content-center border-t border-[#2a2d36] ">
    {faqs.map((faq, i) => {
      const isOrange = i % 2 === 0;
      const themeColor = isOrange ? '#FF8F3F' : '#82AFFF';
      
      return (
        <div class="faq-item border-b border-[#2a2d36] group cursor-pointer">
          <!-- Accordion Header Row -->
          <div class="flex items-center justify-between py-6 gap-6 select-none">
            
            <div class="flex items-center gap-8 md:gap-12 flex-1">
              <!-- Number Box -->
              <span style={`
                font-family: 'Orbitron', sans-serif !important;
                font-size: 26px;
                font-weight: 450;
                color: ${themeColor};
              `}>
                {String(i + 1).padStart(2, '0')}
              </span>
              
              <!-- Question Text -->
              <h3 style={`
                color: ${themeColor};
                font-family: 'Abel', sans-serif !important;
                font-size: 27px;
                font-style: normal;
                font-weight: 400;
                line-height: 140%;
              `}>
                {faq.q}
              </h3>
            </div>

            <!-- Custom Chevron Arrow Icon -->
            <div class="chevron-icon transition-transform duration-300 transform">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={themeColor} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            
          </div>

          <!-- Accordion Expandable Content Panel -->
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="pb-6 pl-[52px] md:pl-[68px] pr-6">
              <p style="
                color: #c4c7cf;
                font-family: 'Abel', sans-serif !important;
                font-size: 18px;
                font-style: normal;
                font-weight: 400;
                line-height: 150%;
              ">
                {faq.a}
              </p>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  // Seamless client-side Accordion Toggler Logic
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach(item => {
    item.addEventListener('click', () => {
      const content = item.querySelector('.faq-content');
      const chevron = item.querySelector('.chevron-icon');
      
      // Check if this item is already active
      const isOpen = item.classList.contains('active');

      // Close all other open accordion panels first
      faqItems.forEach(otherItem => {
        otherItem.classList.remove('active');
        const otherContent = otherItem.querySelector('.faq-content');
        if (otherContent) otherContent.style.maxHeight = '0';
        const otherChevron = otherItem.querySelector('.chevron-icon');
        if (otherChevron) otherChevron.classList.remove('rotate-180');
      });

      // Toggle current panel status
      if (!isOpen && content) {
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';
        if (chevron) chevron.classList.add('rotate-180');
      }
    });
  });
</script>