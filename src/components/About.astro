<script>
  function updateTimer() {
    const minutesEl = document.getElementById('minutes');
    if(minutesEl) {
      let text = minutesEl.innerText;
      let mins = parseInt(text);
      if(!isNaN(mins)) {
        mins = mins > 0 ? mins - 1 : 59;
        minutesEl.innerText = `${mins.toString().padStart(2, '0')} Mins`;
      }
    }
  }
  setInterval(updateTimer, 60000);
</script>