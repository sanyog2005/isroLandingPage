<section class="hero-root relative min-h-[500px] lg:min-h-[700px] flex flex-col justify-start px-4 md:px-20 lg:px-6 pt-16 lg:pt-20 mt-10 pb-0 overflow-hidden">
  
  <div class="absolute inset-0 w-full h-full z-0 block lg:hidden py-10">
    <img 
      src="/assets/heroBGMobile.webp" 
      alt="Hero Background" 
      class="hero-image w-full h-full object-cover object-center" 
      fetchpriority="high"
    />
  </div>

  <div class="absolute inset-0 w-full h-full z-0 hidden lg:block">
    <video 
      id="hero-video"
      loop 
      muted 
      playsinline 
      preload="none" 
      poster="/assets/vidBG.webp" 
      class="hero-image w-full h-full object-cover object-center transition-opacity duration-1000"
    >
      <source data-src="../../assets/vide.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="relative z-20 max-w-4xl mt-10 md:mt-16">
  </div>

</section>
<script>
  window.addEventListener('load', () => {
    
    // NEW: Check if the screen is smaller than Tailwind's 'lg' breakpoint (1024px)
    // If it's a mobile device, stop immediately and don't download the video.
    if (window.innerWidth < 924) return;

    const video = document.getElementById('hero-video') as HTMLVideoElement;
    if (!video) return;

    const source = video.querySelector('source');
    if (!source) return;

    setTimeout(() => {
      source.src = source.dataset.src || '';
      
      video.load();
      video.play().catch(error => {
        console.warn("Video autoplay was prevented:", error);
      });
    }, 1000); 

  });
</script>